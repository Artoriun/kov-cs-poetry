# Copy to packages/api/.env for local development. That file is gitignored.
# On Render these are set in the service's Environment tab instead.

# ── Required ───────────────────────────────────────────────────────────────────
# Signs the admin JWT. Any long random string; changing it invalidates every
# existing admin token.
JWT_SECRET=

# The admin password, as a scrypt hash rather than the password itself, so the
# hosting dashboard and any leaked log no longer contain it. Generate with
# `npm run hash-password` from the repo root.
ADMIN_PASSWORD_HASH=

# Plaintext fallback, only for getting a local instance running quickly. If both
# are set the hash wins. Do not use this on a deployed instance.
# ADMIN_PASSWORD=

# ── Firestore ──────────────────────────────────────────────────────────────────
# Without these the API still answers: it falls back to the poems bundled in
# packages/shared and the admin portal cannot save. /health/deps reports which.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# The whole PEM including the BEGIN/END lines. Newlines survive as \n.
FIREBASE_PRIVATE_KEY=
# Passed to initializeApp and nothing else — no code calls bucket(). Poem images go
# to Cloudinary, not here.
FIREBASE_STORAGE_BUCKET=

# ── Where the browser calls from ───────────────────────────────────────────────
# One extra allowed origin on top of http://localhost:3000, which is always
# permitted. This is the deployed site's origin.
CORS_ORIGIN=

# ── Image uploads ──────────────────────────────────────────────────────────────
# cloudinary://<api-key>:<api-secret>@<cloud-name>. Read by the Cloudinary SDK
# itself rather than through process.env, so it does not appear in a grep of the
# source — but the module throws at import if it is set to anything that is not a
# cloudinary:// URL, which takes the whole API down before it serves a request.
CLOUDINARY_URL=

# ── Contact form ───────────────────────────────────────────────────────────────
# Where submissions are delivered. Falls back to a hardcoded address if unset.
CONTACT_TO=

# Preferred sender. If RESEND_API_KEY is set the SMTP block below is ignored.
RESEND_API_KEY=
# Defaults to onboarding@resend.dev, which only delivers to your own address.
RESEND_FROM=

# SMTP fallback, used only when RESEND_API_KEY is absent. All three of HOST,
# USER and PASS must be set or the transport is not created at all.
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=

# ── Optional ───────────────────────────────────────────────────────────────────
# Port for local dev.
# PORT=4000
# How long /health/deps waits on Firestore before reporting it unreachable.
# HEALTH_DEPS_TIMEOUT_MS=5000
